{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "area.schema.json",
  "title": "Область для исследования (areas/<id>.json)",
  "type": "object",
  "properties": {
    "_comment": {
      "type": "string",
      "description": "Комментарий автора, игрой не читается."
    },
    "title_key": {
      "$ref": "common.schema.json#/$defs/locale_key"
    },
    "map": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[.,#T=+]+$",
        "maxLength": 128
      },
      "minItems": 1,
      "maxItems": 128,
      "description": ". земля, , дорога, # постройка, T дерево, = плетень, + могила"
    },
    "spawns": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/cell"
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name_key": {
            "$ref": "common.schema.json#/$defs/locale_key"
          },
          "at": {
            "$ref": "common.schema.json#/$defs/cell"
          },
          "look": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "dialog": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "name_key",
          "at"
        ]
      }
    },
    "encounters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "trigger": {
            "enum": [
              "zone",
              "sight"
            ]
          },
          "zone": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x, z, ширина, глубина] в клетках области."
          },
          "sight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "description": "Радиус взгляда противников, клеток."
          },
          "battle": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "Участок карты, где идёт бой."
          },
          "combatants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "creature": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "team": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "at": {
                  "$ref": "common.schema.json#/$defs/cell"
                }
              },
              "additionalProperties": false,
              "required": [
                "id",
                "creature",
                "team",
                "at"
              ]
            },
            "minItems": 1
          },
          "then": {
            "$ref": "common.schema.json#/$defs/event_actions",
            "description": "Действия при победе (ADR-0034)."
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "trigger",
          "battle",
          "combatants"
        ],
        "description": "Энкаунтер (ADR-0032): кто ждёт на карте и что запускает бой."
      }
    },
    "interior": {
      "type": "boolean",
      "description": "Помещение: стены ниже, чтобы камера видела комнату."
    },
    "exits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name_key": {
            "$ref": "common.schema.json#/$defs/locale_key"
          },
          "at": {
            "$ref": "common.schema.json#/$defs/cell"
          },
          "to": {
            "type": "object",
            "properties": {
              "area": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "spawn": {
                "$ref": "common.schema.json#/$defs/id"
              }
            },
            "additionalProperties": false,
            "required": [
              "area",
              "spawn"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "name_key",
          "at",
          "to"
        ]
      },
      "description": "Выходы в другие области: встал на клетку — перешёл (ADR-0034)."
    },
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name_key": {
            "$ref": "common.schema.json#/$defs/locale_key"
          },
          "at": {
            "$ref": "common.schema.json#/$defs/cell"
          },
          "prop": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/stack"
            }
          },
          "purse": {
            "type": "integer",
            "minimum": 0
          },
          "then": {
            "$ref": "common.schema.json#/$defs/event_actions"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "name_key",
          "at"
        ]
      },
      "description": "Сундуки: содержимое и действия при первом открытии (ADR-0034)."
    },
    "style": {
      "type": "object",
      "properties": {
        "tree": {
          "$ref": "common.schema.json#/$defs/ids",
          "description": "Модели для T."
        },
        "house": {
          "$ref": "common.schema.json#/$defs/ids",
          "description": "Для построек # до 8 клеток."
        },
        "house_large": {
          "$ref": "common.schema.json#/$defs/ids",
          "description": "Для построек # больше 8 клеток."
        },
        "well": {
          "$ref": "common.schema.json#/$defs/ids",
          "description": "Для построек # из одной клетки."
        },
        "fence": {
          "$ref": "common.schema.json#/$defs/ids",
          "description": "Для плетня =."
        },
        "grave": {
          "$ref": "common.schema.json#/$defs/ids",
          "description": "Для могил +."
        },
        "yard": {
          "$ref": "common.schema.json#/$defs/ids",
          "description": "Мелочи на клетках постройки, не занятых домом."
        },
        "scatter": {
          "$ref": "common.schema.json#/$defs/ids",
          "description": "Мелочи на земле (без влияния на проходимость)."
        }
      },
      "additionalProperties": false,
      "description": "Какими моделями рисовать символы карты (ADR-0033). Без стиля — простая геометрия."
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prop": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "at": {
            "$ref": "common.schema.json#/$defs/cell"
          },
          "size": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "Клетки [ширина, глубина], по умолчанию 1×1."
          },
          "rotation": {
            "enum": [
              0,
              90,
              180,
              270
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "prop",
          "at"
        ]
      },
      "description": "Модели в заданных клетках; проходимость по-прежнему задаёт карта."
    }
  },
  "additionalProperties": false,
  "required": [
    "title_key",
    "map",
    "spawns"
  ]
}
