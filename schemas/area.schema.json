{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "area.schema.json",
  "title": "Область для исследования (areas/<id>.json)",
  "type": "object",
  "properties": {
    "_comment": {
      "type": "string",
      "description": "Комментарий автора, игрой не читается."
    },
    "title_key": {
      "$ref": "common.schema.json#/$defs/locale_key"
    },
    "map": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[.,#T=+]+$",
        "maxLength": 128
      },
      "minItems": 1,
      "maxItems": 128,
      "description": ". земля, , дорога, # постройка, T дерево, = плетень, + могила"
    },
    "spawns": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/cell"
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name_key": {
            "$ref": "common.schema.json#/$defs/locale_key"
          },
          "at": {
            "$ref": "common.schema.json#/$defs/cell"
          },
          "look": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "dialog": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "name_key",
          "at"
        ]
      }
    },
    "encounters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "trigger": {
            "enum": [
              "zone",
              "sight"
            ]
          },
          "zone": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x, z, ширина, глубина] в клетках области."
          },
          "sight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "description": "Радиус взгляда противников, клеток."
          },
          "battle": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "Участок карты, где идёт бой."
          },
          "combatants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "creature": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "team": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "at": {
                  "$ref": "common.schema.json#/$defs/cell"
                }
              },
              "additionalProperties": false,
              "required": [
                "id",
                "creature",
                "team",
                "at"
              ]
            },
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "trigger",
          "battle",
          "combatants"
        ],
        "description": "Энкаунтер (ADR-0032): кто ждёт на карте и что запускает бой."
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "title_key",
    "map",
    "spawns"
  ]
}
