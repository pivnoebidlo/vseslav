{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Общие определения",
  "description": "Общие определения для схем файлов модуля (ADR-0028).",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.]+$",
      "maxLength": 64,
      "description": "Идентификатор: строчные латинские буквы, цифры, _ и ."
    },
    "ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "locale_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.]+$",
      "maxLength": 128,
      "description": "Ключ строки в locales/<язык>.json."
    },
    "formula": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Формула кубиков: 1d8 + STR, 8 + PROF + SPELL (docs/rules)."
    },
    "ability": {
      "enum": [
        "str",
        "dex",
        "con",
        "int",
        "wis",
        "cha"
      ]
    },
    "abilities": {
      "type": "object",
      "properties": {
        "str": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "dex": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "con": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "int": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "wis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "cha": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      },
      "additionalProperties": false
    },
    "ability_bonus": {
      "type": "object",
      "properties": {
        "str": {
          "type": "integer",
          "minimum": -5,
          "maximum": 5
        },
        "dex": {
          "type": "integer",
          "minimum": -5,
          "maximum": 5
        },
        "con": {
          "type": "integer",
          "minimum": -5,
          "maximum": 5
        },
        "int": {
          "type": "integer",
          "minimum": -5,
          "maximum": 5
        },
        "wis": {
          "type": "integer",
          "minimum": -5,
          "maximum": 5
        },
        "cha": {
          "type": "integer",
          "minimum": -5,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "damage_type": {
      "enum": [
        "acid",
        "bludgeoning",
        "cold",
        "fire",
        "force",
        "lightning",
        "necrotic",
        "piercing",
        "poison",
        "psychic",
        "radiant",
        "slashing",
        "thunder"
      ]
    },
    "condition": {
      "enum": [
        "blinded",
        "frightened",
        "incapacitated",
        "poisoned",
        "prone",
        "restrained",
        "stunned",
        "unconscious",
        "dodging",
        "marked",
        "sapped",
        "vexed",
        "raging",
        "reckless",
        "blessed",
        "guided",
        "barkskin"
      ]
    },
    "attack_type": {
      "enum": [
        "melee",
        "ranged"
      ]
    },
    "stack": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "object",
          "properties": {
            "item": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "item"
          ]
        }
      ],
      "description": "Предмет: id или {item, count}."
    },
    "damage_part": {
      "type": "object",
      "properties": {
        "formula": {
          "$ref": "common.schema.json#/$defs/formula"
        },
        "type": {
          "$ref": "common.schema.json#/$defs/damage_type"
        }
      },
      "additionalProperties": false,
      "required": [
        "formula",
        "type"
      ]
    },
    "effect": {
      "type": "object",
      "properties": {
        "on": {
          "enum": [
            "hit",
            "failed_save",
            "always"
          ]
        },
        "condition": {
          "$ref": "common.schema.json#/$defs/condition"
        },
        "rounds": {
          "type": "integer",
          "minimum": 0
        },
        "save_ends": {
          "$ref": "common.schema.json#/$defs/ability"
        },
        "save_ability": {
          "$ref": "common.schema.json#/$defs/ability"
        }
      },
      "additionalProperties": false,
      "required": [
        "condition"
      ]
    },
    "trait": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "pack_tactics",
            "bonus_damage",
            "attack_bonus",
            "ac_bonus",
            "improved_critical",
            "protection",
            "revive",
            "aura",
            "initiative",
            "hp_per_level",
            "unarmored_defense",
            "heal_bonus",
            "savage_attacker",
            "extra_attack",
            "speed_bonus",
            "uncanny_dodge"
          ]
        },
        "name_key": {
          "$ref": "common.schema.json#/$defs/locale_key"
        },
        "value": {
          "type": "integer"
        },
        "formula": {
          "$ref": "common.schema.json#/$defs/formula"
        },
        "damage_type": {
          "$ref": "common.schema.json#/$defs/damage_type"
        },
        "when": {
          "enum": [
            "",
            "target_wounded",
            "target_marked",
            "armored",
            "adjacent_ally",
            "sneak",
            "raging",
            "raging_reckless"
          ]
        },
        "attack_type": {
          "$ref": "common.schema.json#/$defs/attack_type"
        },
        "once_per_turn": {
          "type": "boolean"
        },
        "ability": {
          "$ref": "common.schema.json#/$defs/ability"
        },
        "dc": {
          "type": "integer",
          "minimum": 1
        },
        "condition": {
          "$ref": "common.schema.json#/$defs/condition"
        },
        "radius": {
          "type": "integer",
          "minimum": 1
        },
        "rounds": {
          "type": "integer",
          "minimum": 0
        },
        "tags": {
          "$ref": "common.schema.json#/$defs/ids"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "action": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name_key": {
          "$ref": "common.schema.json#/$defs/locale_key"
        },
        "kind": {
          "enum": [
            "attack",
            "save",
            "heal",
            "effect",
            "multiattack"
          ]
        },
        "cost": {
          "enum": [
            "action",
            "bonus",
            "reaction",
            "free"
          ]
        },
        "attack_type": {
          "$ref": "common.schema.json#/$defs/attack_type"
        },
        "attack_bonus": {
          "$ref": "common.schema.json#/$defs/formula"
        },
        "range": {
          "type": "integer",
          "minimum": 0
        },
        "long_range": {
          "type": "integer",
          "minimum": 0
        },
        "damage": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/damage_part"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/effect"
          }
        },
        "tags": {
          "$ref": "common.schema.json#/$defs/ids"
        },
        "target": {
          "enum": [
            "enemy",
            "ally",
            "self",
            "point"
          ]
        },
        "area": {
          "enum": [
            "burst",
            "cone"
          ]
        },
        "area_size": {
          "type": "integer",
          "minimum": 1
        },
        "save_ability": {
          "$ref": "common.schema.json#/$defs/ability"
        },
        "save_dc": {
          "$ref": "common.schema.json#/$defs/formula"
        },
        "save_half": {
          "type": "boolean"
        },
        "heal": {
          "$ref": "common.schema.json#/$defs/formula"
        },
        "concentration": {
          "type": "boolean"
        },
        "spell_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9,
          "description": "Круг заклинания (ADR-0044): тратит ячейку slot_<круг> или ближайшую выше."
        },
        "upcast": {
          "type": "string",
          "pattern": "^[1-9][0-9]?d[0-9]{1,3}$",
          "description": "Кости к урону или лечению за каждый круг ячейки выше круга заклинания."
        },
        "at_level": {
          "type": "object",
          "description": "Урон заговора с уровня персонажа: {\"5\": {\"damage\": [...]}}.",
          "propertyNames": {
            "pattern": "^([1-9]|1[0-9]|20)$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "damage": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/damage_part"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "resource": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "resource_cost": {
          "type": "integer",
          "minimum": 1
        },
        "special": {
          "enum": [
            "dash",
            "disengage",
            "dodge",
            "extra_action",
            "stand",
            "shove",
            "shove_prone",
            "reckless"
          ]
        },
        "sub_actions": {
          "$ref": "common.schema.json#/$defs/ids"
        },
        "mastery": {
          "enum": [
            "cleave",
            "graze",
            "nick",
            "push",
            "sap",
            "slow",
            "topple",
            "vex"
          ]
        },
        "ability": {
          "enum": [
            "str",
            "dex",
            "con",
            "int",
            "wis",
            "cha",
            "spell"
          ],
          "description": "Характеристика атаки; spell — заклинательная характеристика класса."
        },
        "item": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "consumes": {
          "type": "boolean"
        },
        "two_handed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "inventory": {
      "type": "object",
      "properties": {
        "armor": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "main_hand": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "off_hand": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "belt": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/stack"
          },
          "maxItems": 4
        },
        "bag": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/stack"
          }
        },
        "purse": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "flag_value": {
      "type": [
        "boolean",
        "integer",
        "string"
      ]
    },
    "flag_condition": {
      "type": "object",
      "properties": {
        "flag": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "eq": {
          "$ref": "common.schema.json#/$defs/flag_value"
        }
      },
      "additionalProperties": false,
      "required": [
        "flag"
      ],
      "description": "Условие: флаг равен значению (не заданный флаг — false)."
    },
    "flag_conditions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/flag_condition"
      }
    },
    "event_action": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "set_flag"
            },
            "flag": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "value": {
              "$ref": "common.schema.json#/$defs/flag_value"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "flag"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "set_quest"
            },
            "quest": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "stage": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "quest",
            "stage"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "give_item"
            },
            "item": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "item"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "take_item"
            },
            "item": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "item"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "give_money"
            },
            "kuny": {
              "type": "integer",
              "minimum": -100000,
              "maximum": 100000
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "kuny"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "give_xp"
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "amount"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "join_party"
            },
            "character": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "character"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "leave_party"
            },
            "character": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "character"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "message"
            },
            "text": {
              "$ref": "common.schema.json#/$defs/locale_key"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "start_dialog"
            },
            "dialog": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "speaker": {
              "$ref": "common.schema.json#/$defs/locale_key"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "dialog"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "start_combat"
            },
            "encounter": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "encounter"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "teleport"
            },
            "area": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "spawn": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "area",
            "spawn"
          ]
        }
      ],
      "description": "Действие (SPEC §8, ADR-0034, ADR-0042, ADR-0043): set_flag, set_quest, give_item, take_item, give_money, give_xp, join_party, leave_party, message, start_dialog, start_combat, teleport."
    },
    "event_actions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/event_action"
      }
    },
    "cell": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    }
  }
}
