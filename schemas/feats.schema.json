{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feats.schema.json",
  "title": "Черты (rules/feats.json, ADR-0044)",
  "type": "object",
  "properties": {
    "_comment": {
      "type": "string",
      "description": "Комментарий автора, игрой не читается."
    },
    "feats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name_key": {
            "$ref": "common.schema.json#/$defs/locale_key"
          },
          "desc_key": {
            "$ref": "common.schema.json#/$defs/locale_key"
          },
          "classes": {
            "$ref": "common.schema.json#/$defs/ids",
            "description": "Кому доступна; пусто — всем."
          },
          "traits": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/trait"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "name_key",
          "desc_key"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "feats"
  ]
}
