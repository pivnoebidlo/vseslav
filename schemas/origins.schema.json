{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "origins.schema.json",
  "title": "Происхождения (rules/origins.json)",
  "type": "object",
  "properties": {
    "_comment": {
      "type": "string",
      "description": "Комментарий автора, игрой не читается."
    },
    "origins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name_key": {
            "$ref": "common.schema.json#/$defs/locale_key"
          },
          "abilities": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/ability"
            }
          },
          "traits": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/trait"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "name_key"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "origins"
  ]
}
